{
  "dashboard": {
    "title": "UPI Fraud Detection Pipeline",
    "tags": ["upi", "fraud", "anomaly"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Transactions Processed (Total)",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(upi_transactions_processed_total{status=\"processed\"})",
            "legendFormat": "Processed"
          }
        ],
        "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4}
      },
      {
        "id": 2,
        "title": "Anomalies Detected (Total)",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(upi_transactions_processed_total{status=\"anomaly\"})",
            "legendFormat": "Anomalies"
          }
        ],
        "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4}
      },
      {
        "id": 3,
        "title": "Anomaly Rate",
        "type": "gauge",
        "targets": [
          {
            "expr": "sum(upi_transactions_processed_total{status=\"anomaly\"}) / sum(upi_transactions_processed_total{status=\"processed\"}) * 100",
            "legendFormat": "Anomaly Rate %"
          }
        ],
        "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}},
        "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4}
      },
      {
        "id": 4,
        "title": "Batch Processing Latency",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(upi_batch_processing_duration_seconds_bucket[5m]))",
            "legendFormat": "p50"
          },
          {
            "expr": "histogram_quantile(0.95, rate(upi_batch_processing_duration_seconds_bucket[5m]))",
            "legendFormat": "p95"
          },
          {
            "expr": "histogram_quantile(0.99, rate(upi_batch_processing_duration_seconds_bucket[5m]))",
            "legendFormat": "p99"
          }
        ],
        "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8}
      },
      {
        "id": 5,
        "title": "Anomalies by Rule",
        "type": "piechart",
        "targets": [
          {
            "expr": "sum by (rule_id) (upi_anomalies_detected_total)",
            "legendFormat": "{{rule_id}}"
          }
        ],
        "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8}
      },
      {
        "id": 6,
        "title": "Throughput (txn/sec)",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(upi_transactions_processed_total{status=\"processed\"}[1m])",
            "legendFormat": "Throughput"
          }
        ],
        "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8}
      },
      {
        "id": 7,
        "title": "Pipeline Errors",
        "type": "graph",
        "targets": [
          {
            "expr": "sum by (error_type, stage) (rate(upi_pipeline_errors_total[5m]))",
            "legendFormat": "{{error_type}} - {{stage}}"
          }
        ],
        "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8}
      },
      {
        "id": 8,
        "title": "Worker Backpressure",
        "type": "graph",
        "targets": [
          {
            "expr": "upi_worker_backpressure_active",
            "legendFormat": "Waiting Workers"
          },
          {
            "expr": "upi_active_workers",
            "legendFormat": "Active Workers"
          }
        ],
        "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8}
      },
      {
        "id": 9,
        "title": "Anomaly Score Distribution",
        "type": "heatmap",
        "targets": [
          {
            "expr": "sum(rate(upi_anomaly_score_bucket[5m])) by (le)",
            "format": "heatmap",
            "legendFormat": "{{le}}"
          }
        ],
        "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8}
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "10s"
  },
  "overwrite": true
}
